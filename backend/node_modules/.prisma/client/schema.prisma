generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CLIENT
}

enum OrderStatus {
  PENDING
  IN_PROGRESS
  REVIEW
  COMPLETED
}

enum InvoiceStatus {
  PENDING_DEPOSIT
  UNPAID
  PAID
}

enum ActivityType {
  STATUS_CHANGED
  COMMENT
  ATTACHMENT_UPLOADED
  INVOICE_CREATED
  PAYMENT_MADE
  ORDER_CREATED
  WORKSPACE_CREATED
}

model Workspace {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now())

  users  User[]
  orders Order[]
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  role         Role
  workspaceId  String   @db.Uuid
  createdAt    DateTime @default(now())

  workspace           Workspace       @relation(fields: [workspaceId], references: [id])
  createdOrders       Order[]         @relation("OrderCreator")
  uploadedAttachments Attachment[]    @relation("AttachmentUploader")
  orderComments       OrderComment[]
  orderActivities     OrderActivity[]
}

model Order {
  id          String      @id @default(uuid()) @db.Uuid
  orderNumber String      @unique
  projectName String
  serviceType String
  description String
  budgetRange String
  deadline    DateTime
  status      OrderStatus @default(PENDING)
  workspaceId String      @db.Uuid
  createdById String      @db.Uuid
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  workspace   Workspace       @relation(fields: [workspaceId], references: [id])
  createdBy   User            @relation("OrderCreator", fields: [createdById], references: [id])
  attachments Attachment[]
  invoices    Invoice[]
  comments    OrderComment[]
  activities  OrderActivity[]
}

model Attachment {
  id           String   @id @default(uuid()) @db.Uuid
  fileName     String
  fileUrl      String
  orderId      String   @db.Uuid
  uploadedById String   @db.Uuid
  commentId    String?  @db.Uuid
  createdAt    DateTime @default(now())

  order      Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  uploadedBy User          @relation("AttachmentUploader", fields: [uploadedById], references: [id])
  comment    OrderComment? @relation(fields: [commentId], references: [id], onDelete: SetNull)
}

model Invoice {
  id            String        @id @default(uuid()) @db.Uuid
  invoiceNumber String        @unique
  orderId       String        @db.Uuid
  amount        Decimal       @db.Decimal(10, 2)
  status        InvoiceStatus @default(UNPAID)
  dueDate       DateTime
  paidAt        DateTime?
  createdAt     DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model OrderComment {
  id        String   @id @default(uuid()) @db.Uuid
  orderId   String   @db.Uuid
  userId    String   @db.Uuid
  text      String
  createdAt DateTime @default(now())

  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id])
  attachments Attachment[]
}

model OrderActivity {
  id        String       @id @default(uuid()) @db.Uuid
  orderId   String       @db.Uuid
  userId    String?      @db.Uuid
  type      ActivityType
  summary   String
  createdAt DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}
